{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🏢 EXECUTIVE MULTI-ORG SYSTEM OVERVIEW",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Average System Health Score",
      "type": "gauge",
      "targets": [
        {
          "expr": "avg(airgap_component_health_score{org=~\"$org\", kind=~\"$kind\"})",
          "legendFormat": "Avg Health"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Max Predictive Risk Score",
      "type": "gauge",
      "targets": [
        {
          "expr": "max(airgap_component_risk_score{org=~\"$org\", kind=~\"$kind\"})",
          "legendFormat": "Max Risk"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Total HTTP Request Throughput (RPS)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(airgap_http_requests_per_sec{org=~\"$org\", kind=~\"$kind\"})",
          "legendFormat": "Total RPS"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Total Network Bandwidth Throughput",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(airgap_network_traffic_bytes_sec{org=~\"$org\", kind=~\"$kind\"})",
          "legendFormat": "Total Network Bps"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "🛡️ CONTROL PLANE / ADMIN SERVERS (org-*-admin-*)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "title": "Admin Control Plane Servers - Bandwidth Utilization %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_interface_utilization_pct{component=~\".*admin.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} ({{org}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "title": "Admin Control Plane Servers - Predictive Risk %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_component_risk_score{component=~\".*admin.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} Risk %"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 300,
      "title": "⚙️ COMPUTE / WORKLOAD SERVERS (org-*-worker-*)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 13 },
      "id": 20,
      "title": "Workload Compute Servers - HTTP Requests/sec (RPS) & Active TCP Connections",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_http_requests_per_sec{component=~\".*worker.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} RPS"
        },
        {
          "expr": "airgap_active_tcp_connections{component=~\".*worker.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} Active TCP Sockets"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 13 },
      "id": 21,
      "title": "Workload Compute Servers - Latency (ms) & Packet Loss %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_latency_ms{component=~\".*worker.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} Latency (ms)"
        },
        {
          "expr": "airgap_packet_loss_pct{component=~\".*worker.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} Packet Loss %"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 400,
      "title": "⚡ APPLICATION MICROSERVICES & APPS",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "id": 60,
      "title": "Microservices - HTTP Throughput (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_http_requests_per_sec{kind=\"service\", org=~\"$org\"}",
          "legendFormat": "{{component}} RPS"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "id": 61,
      "title": "Microservices - Error Rate % & Health Score",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_error_rate_pct{kind=\"service\", org=~\"$org\"}",
          "legendFormat": "{{component}} Error Rate %"
        },
        {
          "expr": "airgap_component_health_score{kind=\"service\", org=~\"$org\"}",
          "legendFormat": "{{component}} Health"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 500,
      "title": "⌛ PREDICTIVE TIME-TO-IMPACT (TTI) LEAD TIME FORECASTS",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "green", "value": 15 }
            ]
          },
          "unit": "m"
        }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 27 },
      "id": 50,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Predicted Lead Time (TTI Mins) Before SLA Breach across 44 Components",
      "type": "stat",
      "targets": [
        {
          "expr": "airgap_time_to_impact_minutes{org=~\"$org\", kind=~\"$kind\"}",
          "legendFormat": "{{component}} TTI"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["airgap", "noc", "copilot", "predictive", "telemetry"],
