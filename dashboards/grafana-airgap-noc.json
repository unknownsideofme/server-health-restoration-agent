{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🏢 EXECUTIVE MULTI-ORG SYSTEM OVERVIEW",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Average System Health Score",
      "type": "gauge",
      "targets": [
        {
          "expr": "avg(airgap_component_health_score{org=~\"$org\", kind=~\"$kind\"})",
          "legendFormat": "Avg Health"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Max Predictive Risk Score",
      "type": "gauge",
      "targets": [
        {
          "expr": "max(airgap_component_risk_score{org=~\"$org\", kind=~\"$kind\"})",
          "legendFormat": "Max Risk"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active Predictive Alerts Count",
      "type": "stat",
      "targets": [
        {
          "expr": "count(airgap_component_risk_score{org=~\"$org\", kind=~\"$kind\"} > 50) or vector(0)",
          "legendFormat": "Elevated Alerts"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "🛡️ CONTROL PLANE / ADMIN SERVERS (org-*-admin-*)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "title": "Admin Control Plane Servers - Bandwidth Utilization %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_interface_utilization_pct{component=~\".*admin.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} ({{org}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "title": "Admin Control Plane Servers - Predictive Risk %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_component_risk_score{component=~\".*admin.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} Risk %"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 300,
      "title": "⚙️ COMPUTE / WORKLOAD SERVERS (org-*-worker-*)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 13 },
      "id": 20,
      "title": "Workload Compute Servers - Bandwidth Utilization %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_interface_utilization_pct{component=~\".*worker.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} ({{org}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 13 },
      "id": 21,
      "title": "Workload Compute Servers - Latency (ms) & Packet Loss %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_latency_ms{component=~\".*worker.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} Latency (ms)"
        },
        {
          "expr": "airgap_packet_loss_pct{component=~\".*worker.*\", org=~\"$org\"}",
          "legendFormat": "{{component}} Packet Loss %"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 400,
      "title": "🌐 EDGE ROUTERS & CIDR SUBNETS",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "id": 30,
      "title": "Edge Routers - Bandwidth & Route Flaps",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_interface_utilization_pct{kind=\"router\", org=~\"$org\"}",
          "legendFormat": "{{component}} Utilization %"
        },
        {
          "expr": "airgap_bgp_flap_count{kind=\"router\", org=~\"$org\"}",
          "legendFormat": "{{component}} BGP Flaps"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "id": 31,
      "title": "CIDR Subnets - Health Score & Risk %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_component_health_score{kind=\"subnet\", org=~\"$org\"}",
          "legendFormat": "{{component}} Health Score"
        },
        {
          "expr": "airgap_component_risk_score{kind=\"subnet\", org=~\"$org\"}",
          "legendFormat": "{{component}} Risk %"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 500,
      "title": "🔀 TOR SWITCHES & INFRASTRUCTURE RACKS",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 27 },
      "id": 40,
      "title": "Top-of-Rack (TOR) Switches - Interface Utilization %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_interface_utilization_pct{kind=\"tor\", org=~\"$org\"}",
          "legendFormat": "{{component}} ({{org}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 27 },
      "id": 41,
      "title": "Infrastructure Racks - Health Score & Risk %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "airgap_component_health_score{kind=\"rack\", org=~\"$org\"}",
          "legendFormat": "{{component}} Health"
        },
        {
          "expr": "airgap_component_risk_score{kind=\"rack\", org=~\"$org\"}",
          "legendFormat": "{{component}} Risk %"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "id": 600,
      "title": "⌛ PREDICTIVE TIME-TO-IMPACT (TTI) LEAD TIME FORECASTS",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus-AirGap" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "green", "value": 15 }
            ]
          },
          "unit": "m"
        }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 34 },
      "id": 50,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Predicted Lead Time (TTI Mins) Before SLA Breach",
      "type": "stat",
      "targets": [
        {
          "expr": "airgap_time_to_impact_minutes{org=~\"$org\", kind=~\"$kind\"}",
          "legendFormat": "{{component}} TTI"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
