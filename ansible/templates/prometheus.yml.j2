global:
  scrape_interval: 2s
  evaluation_interval: 2s

scrape_configs:
  - job_name: "airgap-noc-copilot"
    metrics_path: "/metrics"
    static_configs:
      - targets: ["localhost:8085"]

  - job_name: "node"
    metrics_path: "/metrics"
    static_configs:
      - targets: ["localhost:9100"]

  - job_name: "prometheus"
    metrics_path: "/metrics"
    static_configs:
      - targets: ["localhost:9090"]
